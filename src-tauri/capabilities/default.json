{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "window-state:default"
  ]
}
